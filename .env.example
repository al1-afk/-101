# NEXT GITAL — Template des variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# ⚠ Ce fichier est le seul commité — .env.local est git-ignoré.

# ── Frontend ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4001
VITE_GOOGLE_MAPS_API_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gestiq_prod
PG_USER=postgres
PG_PASSWORD=

# ── Backend ─────────────────────────────────────────────────────
SERVER_PORT=4001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ── JWT (secrets 32+ chars) ────────────────────────────────────
# Générer via : openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── SMTP — canal primaire (Titan / Hostinger recommandé) ───────
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NEXT GITAL

# ── Resend — canal secondaire (fallback si SMTP down) ──────────
RESEND_API_KEY=
RESEND_FROM=

# ── OpenAI (module Conseiller IA) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (classification finance + fallback devis IA) ─────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Génération de devis par IA (module ai-quote) ───────────────
# Fournisseur : openai | anthropic | auto (auto = OpenAI puis Anthropic).
AI_QUOTE_PROVIDER=auto
# Override du modèle (sinon défaut du fournisseur choisi).
AI_QUOTE_MODEL=
# Timeout d'un appel IA (ms). 60 s par défaut (JSON structuré = réponses longues).
AI_QUOTE_TIMEOUT_MS=60000
# Interrupteur global de la fonctionnalité (true/false).
AI_QUOTE_GENERATION_ENABLED=true
# Version du prompt (tracée dans ai_quote_generations).
AI_QUOTE_PROMPT_VERSION=v1
